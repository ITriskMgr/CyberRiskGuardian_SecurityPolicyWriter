# Copy to .env and adjust. Never commit .env.
# AI provider: "mock" (offline, default) or "anthropic" (requires a server-side key)
PB_AI_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...
PB_AI_MODEL=claude-sonnet-5-5
PB_AI_MAX_TOKENS=4000
PB_AI_TIMEOUT=90
# Network binding — keep 127.0.0.1 unless you deploy behind TLS
PB_HOST=127.0.0.1
PB_PORT=8120
# Storage. Default: ./data with SQLite. PostgreSQL example:
# PB_DATABASE_URL=postgresql+psycopg://user:pass@localhost/policybuilder
# PB_DATA_DIR=./data
# PB_ENCRYPTION_KEY=   (Fernet key; default is generated in data/pb-key, mode 600)
PB_MAX_UPLOAD_MB=20
PB_SESSION_HOURS=12
# Set to 1 when served over HTTPS
PB_SECURE_COOKIES=0
